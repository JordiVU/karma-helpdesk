<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- acción -->
    <record model="ir.actions.act_window" id="action_tecnico">
        <field name="name">Técnicos</field>
        <field name="res_model">helpdesk.tecnico</field>
        <field name="view_mode">list,form,kanban,graph</field>
    </record>

    <!-- entrada de menú -->
    <menuitem
        name="Técnicos"
        id="menu_tecnicos"
        parent="menu_helpdesk_root"
        action="action_tecnico"
        sequence="20"/>

    <!-- ============================================================ -->
    <!-- Vista lista                                                   -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="lista_tecnico_view">
        <field name="name">helpdesk.tecnico.list</field>
        <field name="model">helpdesk.tecnico</field>
        <field name="arch" type="xml">
            <list decoration-info="nivel == 'experto'"
                  decoration-muted="not activo">
                <field name="nombre"/>
                <field name="especialidad" widget="badge"/>
                <field name="karma"/>
                <field name="nivel" widget="badge"/>
                <field name="bonus_resolucion"/>
                <field name="total_resueltas"/>
                <field name="incidencias_abiertas"/>
                <field name="tiempo_medio_resolucion" digits="[6,1]"/>
                <field name="activo" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Vista formulario                                             -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="form_tecnico_view">
        <field name="name">helpdesk.tecnico.form</field>
        <field name="model">helpdesk.tecnico</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Datos">
                            <field name="nombre"/>
                            <field name="email"/>
                            <field name="especialidad"/>
                            <field name="activo"/>
                        </group>
                        <group string="Karma y nivel">
                            <field name="karma"/>
                            <field name="nivel" widget="badge"/>
                            <field name="bonus_resolucion" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rendimiento">
                        <field name="total_resueltas"/>
                        <field name="incidencias_abiertas"/>
                        <field name="tiempo_medio_resolucion" digits="[6,2]"/>
                    </group>
                    <notebook>
                        <page string="Incidencias asignadas">
                            <field name="incidencias_ids" readonly="1">
                                <list>
                                    <field name="titulo"/>
                                    <field name="estado" widget="badge"/>
                                    <field name="gravedad" widget="badge"/>
                                    <field name="prioridad"/>
                                    <field name="usuario_id"/>
                                    <field name="fecha_creacion"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Vista kanban                                                  -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="kanban_tecnico_view">
        <field name="name">helpdesk.tecnico.kanban</field>
        <field name="model">helpdesk.tecnico</field>
        <field name="arch" type="xml">
            <kanban default_group_by="nivel">
                <field name="nombre"/>
                <field name="karma"/>
                <field name="nivel"/>
                <field name="bonus_resolucion"/>
                <field name="total_resueltas"/>
                <field name="incidencias_abiertas"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="nombre"/></strong>
                            <div>Karma: <field name="karma"/> — <field name="nivel"/></div>
                            <div>Bonus resolución: +<field name="bonus_resolucion"/> karma</div>
                            <div>Resueltas: <field name="total_resueltas"/></div>
                            <div>Abiertas: <field name="incidencias_abiertas"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Vista gráfico: karma por técnico                             -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="graph_tecnico_view">
        <field name="name">helpdesk.tecnico.graph</field>
        <field name="model">helpdesk.tecnico</field>
        <field name="arch" type="xml">
            <graph string="Karma por técnico" type="bar">
                <field name="nombre" type="row"/>
                <field name="karma" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Vista búsqueda                                               -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="search_tecnico_view">
        <field name="name">helpdesk.tecnico.search</field>
        <field name="model">helpdesk.tecnico</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="especialidad"/>
                <filter name="activos" string="Activos"
                        domain="[('activo', '=', True)]"/>
                <filter name="expertos" string="Expertos"
                        domain="[('nivel', '=', 'experto')]"/>
                <separator/>
                <filter name="group_nivel" string="Por nivel"
                        context="{'group_by': 'nivel'}"/>
                <filter name="group_esp" string="Por especialidad"
                        context="{'group_by': 'especialidad'}"/>
            </search>
        </field>
    </record>

</odoo>
