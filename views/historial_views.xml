<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- acción -->
    <record model="ir.actions.act_window" id="action_historial">
        <field name="name">Historial</field>
        <field name="res_model">helpdesk.historial</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- entrada de menú -->
    <menuitem
        name="Historial"
        id="menu_historial"
        parent="menu_helpdesk_root"
        action="action_historial"
        sequence="30"/>

    <!-- ============================================================ -->
    <!-- Vista lista                                                   -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="lista_historial_view">
        <field name="name">helpdesk.historial.list</field>
        <field name="model">helpdesk.historial</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="incidencia_id"/>
                <field name="accion"/>
                <field name="descripcion"/>
                <field name="usuario_sistema_id"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Vista formulario                                             -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="form_historial_view">
        <field name="name">helpdesk.historial.form</field>
        <field name="model">helpdesk.historial</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="incidencia_id" readonly="1"/>
                        <field name="accion" readonly="1"/>
                        <field name="fecha" readonly="1"/>
                        <field name="usuario_sistema_id" readonly="1"/>
                    </group>
                    <group string="Descripción">
                        <field name="descripcion" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Vista búsqueda                                               -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="search_historial_view">
        <field name="name">helpdesk.historial.search</field>
        <field name="model">helpdesk.historial</field>
        <field name="arch" type="xml">
            <search>
                <field name="incidencia_id"/>
                <field name="accion"/>
                <separator/>
                <filter name="group_incidencia" string="Por incidencia"
                        context="{'group_by': 'incidencia_id'}"/>
                <filter name="group_accion" string="Por tipo acción"
                        context="{'group_by': 'accion'}"/>
            </search>
        </field>
    </record>

</odoo>
